{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/common/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/common/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/app",
  "projects": {
    "analytics-sink": {
      "type": "application",
      "root": "apps/analytics-sink",
      "entryFile": "main",
      "sourceRoot": "apps/analytics-sink/src",
      "compilerOptions": {
        "tsConfigPath": "apps/analytics-sink/tsconfig.app.json"
      }
    },
    "scheduler": {
      "type": "application",
      "root": "apps/scheduler",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler/tsconfig.app.json"
      }
    },
    "telegram": {
      "type": "application",
      "root": "apps/telegram",
      "entryFile": "main",
      "sourceRoot": "apps/telegram/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telegram/tsconfig.app.json"
      }
    }
  }
}